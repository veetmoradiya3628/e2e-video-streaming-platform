# Server
PORT=3000
NODE_ENV=development

# AWS
AWS_REGION=<your-aws-region> // e.g., us-east-1, ap-south-1
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# S3
AWS_S3_BUCKET=<your-s3-bucket-name>

# DynamoDB
DYNAMODB_VIDEOS_TABLE=<your-videos-table-name>
DYNAMODB_USERS_TABLE=<your-users-table-name>

# JWT
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRES_IN=<your-jwt-expiry-time>

# S3 Base URL
S3_BASE_URL=<your-s3-base-url>